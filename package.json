{
  "name": "ai-labs-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first multi-company AI organization and development orchestration platform.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ConrayGambit/ai-labs-platform.git"
  },
  "bugs": {
    "url": "https://github.com/ConrayGambit/ai-labs-platform/issues"
  },
  "homepage": "https://github.com/ConrayGambit/ai-labs-platform#readme",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "guard": "node scripts/check-no-real-data.mjs",
    "guard:history": "node scripts/check-no-real-data.mjs --history",
    "verify": "npm run guard && npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.66.0",
    "@fastify/static": "10.1.3",
    "@fastify/websocket": "11.3.0",
    "better-sqlite3": "12.11.1",
    "fastify": "5.11.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "9.2.4",
    "jsdom": "29.1.1",
    "tsx": "4.23.11",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
